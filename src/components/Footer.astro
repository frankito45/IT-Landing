---

interface Props {
    Brand: string
    BrandColor:string
    tagline:string
    SocialMedia: {
        Instagram: string
        WhatsApp: string
        Facebook: string
        Correo: string
        TimeWorck: string
        Direccion: string
    }
    

}

const { Brand,  tagline, SocialMedia} = Astro.props

---


<footer class="border-t border-slate-800/60 bg-slate-950">
  <div class="mx-auto max-w-7xl px-8 py-14 lg:px-16">

    <div class="grid gap-10 md:grid-cols-3">

      <!-- Marca -->
      <div>
        <a href="/" class="text-2xl font-bold text-white">
          {Brand}
        </a>

        <p class="mt-4 max-w-sm text-sm leading-6 text-slate-400">
          {tagline}
        </p>

        <!-- Redes -->
        <div class="mt-6">
          <p class="mb-4 text-xs font-bold uppercase tracking-widest text-slate-400">
            Seguinos
          </p>

          <div class="flex gap-2">

            <!-- WhatsApp -->
            <a
              href={SocialMedia.WhatsApp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              class="group flex h-10 w-10 items-center justify-center rounded-xl
                     border border-slate-800 bg-slate-900 text-slate-400
                     transition-all duration-200
                     hover:border-[#25D366]/40 hover:bg-[#25D366]/10
                     hover:text-[#25D366]"
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.438 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href={SocialMedia.Instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="group flex h-10 w-10 items-center justify-center rounded-xl
                     border border-slate-800 bg-slate-900 text-slate-400
                     transition-all duration-200
                     hover:border-[#E4405F]/40 hover:bg-[#E4405F]/10
                     hover:text-[#E4405F]"
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href={SocialMedia.Facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="group flex h-10 w-10 items-center justify-center rounded-xl
                     border border-slate-800 bg-slate-900 text-slate-400
                     transition-all duration-200
                     hover:border-[#1877F2]/40 hover:bg-[#1877F2]/10
                     hover:text-[#1877F2]"
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-8.74h-2.94v-3.411h2.94v-2.518c0-2.91 1.777-4.496 4.375-4.496 1.244 0 2.313.092 2.624.134v3.042h-1.802c-1.413 0-1.687.672-1.687 1.656v2.17h3.366l-.438 3.411h-2.928v8.74h6.035c.732 0 1.325-.593 1.325-1.325v-21.351c0-.732-.593-1.325-1.325-1.325z"/>
              </svg>
            </a>

          </div>
        </div>
      </div>


      <!-- Navegación -->
      <div>
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-slate-400">
          Navegación
        </p>

        <nav class="flex flex-col gap-3 text-sm">
          <a href="/" class="text-slate-400 transition hover:text-white">
            Inicio
          </a>

          <a href="#servicios" class="text-slate-400 transition hover:text-white">
            Servicios
          </a>

          <a href="#nosotros" class="text-slate-400 transition hover:text-white">
            Nosotros
          </a>

          <a href="#contacto" class="text-slate-400 transition hover:text-white">
            Contacto
          </a>
        </nav>
      </div>


      <!-- Contacto -->
      <div>
        <p class="mb-5 text-xs font-bold uppercase tracking-widest text-slate-400">
          Contacto
        </p>

        <div class="flex flex-col gap-4 text-sm">

          <a
            href=`https://www.google.com/maps/search/${SocialMedia.Direccion}`
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 transition hover:text-blue-400"
          >
            {SocialMedia.Direccion}
          </a>

          <a
            href={SocialMedia.WhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 transition hover:text-green-400"
          >
             +54 11 7140 6331
          </a>

          <a
            href={SocialMedia.Correo}
            class="text-slate-400 transition hover:text-blue-400"
          >
            {SocialMedia.Correo}
          </a>

          <p class="text-slate-500">
            {SocialMedia.TimeWorck}
          </p>

        </div>
      </div>

    </div>


    <!-- Bottom -->
    <div class="mt-12 flex flex-col gap-4 border-t border-slate-800/60 pt-6 text-sm md:flex-row md:items-center md:justify-between">

      <p class="text-slate-500">
        &copy; 2026 Tienda IT. Todos los derechos reservados.
      </p>

      <div class="flex gap-6">
        <a
          href="#"
          class="text-slate-500 transition hover:text-slate-300"
        >
          Política de privacidad
        </a>

        <a
          href="#"
          class="text-slate-500 transition hover:text-slate-300"
        >
          Términos y condiciones
        </a>
      </div>

    </div>

  </div>
</footer>
