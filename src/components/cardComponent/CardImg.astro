---

import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    img: ImageMetadata;
}

const { title, description, img } = Astro.props;







---

<div
  class="group rounded-2xl border  border-slate-800 bg-slate-900/50 p-7
         transition-all duration-300
         hover:-translate-y-2 hover:border-blue-500/40 hover:bg-blue-950/20"
>
  <div
    class="mb-5 flex h-48 w-full items-center justify-center overflow-hidden rounded-2xl
         border border-slate-800
         bg-blue-500/10
         transition-all duration-300
         group-hover:shadow-[0_0_20px_rgba(59,130,246,0.35)]
         group-hover:scale-105"
  >
    <Image
      src={img}
      alt={title}
      class="h-full w-full object-cover"
    />
  </div>

  <h3 class="text-xl font-bold">
    {title}
  </h3>

 <p>
    {description}
 </p>
</div>

