---

interface Props {
    title: string;
    description: string;
    icon: ImageMetadata;
}

const { title, description, icon } = Astro.props;


const formatDescription = (description:string):string[] => {
  return description.split('\n')
};



const lista: string[] = formatDescription(description);

---

<div
  class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-7
         transition-all duration-300
         hover:-translate-y-2 hover:border-blue-500/40 hover:bg-blue-950/20 "
>
  <div
    class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl border overflow-hidden  border-slate-800 
           bg-blue-500/10 text-2xl
           transition-all duration-200
           group-hover:border-blue-600/40
           group-hover:bg-blue-900/20
            group-hover:scale-110
             group-hover:shadow-2xl shadow-indigo-700
           "
  >
    <img src={icon.src} alt={title} class="h-full w-full object-contain  " />
  </div>

  <h3 class="text-xl font-bold">
    {title}
  </h3>

  <ul>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=verified_user" />
    {
      lista.map((item) => (
        <li class="mt-3 text-slate-400 flex">

          <span class="material-symbols-outlined transition-all duration-200 group-hover:text-blue-600/40
           group-hover:tex-blue-900/20">
            verified_user
          </span>
        {item}</li>
       ))
    }
  </ul>
</div>

