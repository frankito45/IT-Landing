---
---

<div class="neural-network" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .neural-network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const container = document.querySelector(
    ".neural-network"
  ) as HTMLDivElement | null;

  const canvas = container?.querySelector(
    "canvas"
  ) as HTMLCanvasElement | null;

  if (container && canvas) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      let width = 0;
      let height = 0;
      let animationId = 0;

      const mouse = {
        x: 0,
        y: 0,
        active: false,
        radius: 180,
      };

      const nodes: {
        x: number;
        y: number;
        baseX: number;
        baseY: number;
        vx: number;
        vy: number;
        size: number;
      }[] = [];

      const NODE_COUNT = 85;
      const CONNECTION_DISTANCE = 145;

      /*
       * ==========================
       * TAMAÑO DEL CONTENEDOR
       * ==========================
       */
      function resize() {
        const rect =
          container!.getBoundingClientRect();

        width = rect.width;
        height = rect.height;

        const dpr = Math.min(
          window.devicePixelRatio || 1,
          2
        );

        canvas!.width = width * dpr;
        canvas!.height = height * dpr;

        ctx!.setTransform(
          dpr,
          0,
          0,
          dpr,
          0,
          0
        );

        createNodes();
      }

      /*
       * ==========================
       * CREAR NODOS
       * ==========================
       */
      function createNodes() {
        nodes.length = 0;

        for (
          let i = 0;
          i < NODE_COUNT;
          i++
        ) {
          const x =
            Math.random() * width;

          const y =
            Math.random() * height;

          nodes.push({
            x,
            y,

            baseX: x,
            baseY: y,

            vx:
              (Math.random() - 0.5) *
              0.35,

            vy:
              (Math.random() - 0.5) *
              0.35,

            size:
              Math.random() * 2.2 + 1,
          });
        }
      }

      /*
       * ==========================
       * ACTUALIZAR NODOS
       * ==========================
       */
      function updateNodes() {
        for (const node of nodes) {
          /*
           * Movimiento suave
           */
          node.x += node.vx;
          node.y += node.vy;

          /*
           * Rebote horizontal
           */
          if (
            node.x <= 0 ||
            node.x >= width
          ) {
            node.vx *= -1;
          }

          /*
           * Rebote vertical
           */
          if (
            node.y <= 0 ||
            node.y >= height
          ) {
            node.vy *= -1;
          }

          /*
           * Atracción
           */
          if (mouse.active) {
            const dx =
              mouse.x - node.x;

            const dy =
              mouse.y - node.y;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );

            if (
              distance < mouse.radius &&
              distance > 0
            ) {
              const force =
                (1 -
                  distance /
                    mouse.radius) *
                0.035;

              node.x +=
                dx * force;

              node.y +=
                dy * force;
            }
          }

          /*
           * Volver lentamente
           */
          node.x +=
            (node.baseX - node.x) *
            0.0008;

          node.y +=
            (node.baseY - node.y) *
            0.0008;

          /*
           * Nunca salir del canvas
           */
          node.x = Math.max(
            0,
            Math.min(width, node.x)
          );

          node.y = Math.max(
            0,
            Math.min(height, node.y)
          );
        }
      }

      /*
       * ==========================
       * CONEXIONES
       * ==========================
       */
      function drawConnections() {
        for (
          let i = 0;
          i < nodes.length;
          i++
        ) {
          for (
            let j = i + 1;
            j < nodes.length;
            j++
          ) {
            const a = nodes[i];
            const b = nodes[j];

            const dx =
              a.x - b.x;

            const dy =
              a.y - b.y;

            const distance =
              Math.sqrt(
                dx * dx +
                dy * dy
              );

            if (
              distance <
              CONNECTION_DISTANCE
            ) {
              let opacity =
                1 -
                distance /
                  CONNECTION_DISTANCE;

              /*
               * Brillo cerca del cursor
               */
              if (mouse.active) {
                const da =
                  Math.hypot(
                    a.x - mouse.x,
                    a.y - mouse.y
                  );

                const db =
                  Math.hypot(
                    b.x - mouse.x,
                    b.y - mouse.y
                  );

                const closest =
                  Math.min(da, db);

                if (
                  closest <
                  mouse.radius
                ) {
                  opacity +=
                    (1 -
                      closest /
                        mouse.radius) *
                    0.8;
                }
              }

              opacity =
                Math.min(
                  opacity,
                  1
                );

              ctx!.beginPath();

              ctx!.moveTo(
                a.x,
                a.y
              );

              ctx!.lineTo(
                b.x,
                b.y
              );

              ctx!.strokeStyle =
                `rgba(100, 180, 255, ${
                  opacity * 0.45
                })`;

              ctx!.lineWidth = 1;

              ctx!.stroke();
            }
          }
        }
      }

      /*
       * ==========================
       * DIBUJAR NODOS
       * ==========================
       */
      function drawNodes() {
        for (const node of nodes) {
          let size =
            node.size;

          let opacity =
            0.65;

          if (mouse.active) {
            const distance =
              Math.hypot(
                node.x - mouse.x,
                node.y - mouse.y
              );

            if (
              distance <
              mouse.radius
            ) {
              const proximity =
                1 -
                distance /
                  mouse.radius;

              size +=
                proximity * 3;

              opacity +=
                proximity * 0.35;
            }
          }

          ctx!.beginPath();

          ctx!.arc(
            node.x,
            node.y,
            size,
            0,
            Math.PI * 2
          );

          ctx!.fillStyle =
            `rgba(120, 200, 255, ${opacity})`;

          ctx!.shadowBlur = 10;

          ctx!.shadowColor =
            "rgba(80, 180, 255, 0.8)";

          ctx!.fill();

          ctx!.shadowBlur = 0;
        }
      }

      /*
       * ==========================
       * ANIMACIÓN
       * ==========================
       */
      function draw() {
        ctx!.clearRect(
          0,
          0,
          width,
          height
        );

        updateNodes();
        drawConnections();
        drawNodes();

        animationId =
          requestAnimationFrame(draw);
      }

      /*
       * ==========================
       * ZONA INTERACTIVA
       * ==========================
       *
       * Buscamos el elemento padre
       * del componente.
       */
      const parent =
        container.parentElement;

      /*
       * ==========================
       * MOUSE / TOUCH
       * ==========================
       */
      if (parent) {
        parent.addEventListener(
          "pointermove",
          (event) => {
            const rect =
              parent.getBoundingClientRect();

            mouse.x =
              event.clientX -
              rect.left;

            mouse.y =
              event.clientY -
              rect.top;

            mouse.active =
              mouse.x >= 0 &&
              mouse.x <= rect.width &&
              mouse.y >= 0 &&
              mouse.y <= rect.height;
          }
        );

        parent.addEventListener(
          "pointerleave",
          () => {
            mouse.active = false;
          }
        );

        parent.addEventListener(
          "pointerdown",
          (event) => {
            const rect =
              parent.getBoundingClientRect();

            mouse.x =
              event.clientX -
              rect.left;

            mouse.y =
              event.clientY -
              rect.top;

            mouse.active = true;
          }
        );

        parent.addEventListener(
          "pointerup",
          () => {
            /*
             * En celular se desactiva
             * cuando levantamos el dedo.
             */
            if (
              window.matchMedia(
                "(pointer: coarse)"
              ).matches
            ) {
              mouse.active = false;
            }
          }
        );
      }

      /*
       * ==========================
       * REDIMENSIONAR
       * ==========================
       */
      window.addEventListener(
        "resize",
        resize
      );

      /*
       * ==========================
       * INICIAR
       * ==========================
       */
      resize();
      draw();

      /*
       * ==========================
       * LIMPIEZA ASTRO
       * ==========================
       */
      document.addEventListener(
        "astro:before-swap",
        () => {
          cancelAnimationFrame(
            animationId
          );

          window.removeEventListener(
            "resize",
            resize
          );
        }
      );
    }
  }
</script>

